# ---------------------------------------------------------------------------
# Tienda de Maxi Habana. Copia este archivo a .env.local y rellena los valores.
#
#   cp .env.example .env.local
#
# Sin NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, Clerk entraría en "keyless mode" y se
# crearía una aplicación temporal: la sesión no funciona contra la API y el
# formulario de acceso deja de responder. Desde MxH-0081 eso ya no puede pasar
# a escondidas: next.config.ts revisa la clave y el build falla diciendo qué
# falta. En producción además exige una pk_live_, no la de pruebas.
# ---------------------------------------------------------------------------

# API de NestJS, con el prefijo /api incluido. El puerto lo fija PORT en el
# .env de maxi_api_nestjs (hoy 4000).
API_URL=http://localhost:4000/api

# Instancia de Clerk de la TIENDA (clientes). Tiene que ser la misma que la
# API declara en CLERK_PUBLISHABLE_KEY / CLERK_SECRET_KEY, o la API rechazará
# los tokens que le mande la tienda. La del backoffice es otra distinta.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# URL pública de esta aplicación. En local, el puerto en el que la levantes.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Debe coincidir con STOREFRONT_REVALIDATE_SECRET en el .env de la API: es lo
# que permite a la API invalidar el caché del catálogo cuando algo cambia.
REVALIDATE_SECRET=change-me-in-production

# Formato de precios.
NEXT_PUBLIC_CURRENCY_CODE=USD
NEXT_PUBLIC_CURRENCY_LOCALE=es-CU

# Opcional: URL pública del almacenamiento de imágenes, para autorizarla en el
# optimizador de Next. En local no hace falta — next.config.ts ya trae el
# patrón del MinIO de desarrollo (localhost:9002).
# NEXT_PUBLIC_MEDIA_URL=
